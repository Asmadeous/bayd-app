# /etc/nginx/sites-available/baydspa.ca  →  symlink into sites-enabled/
#
# Single nginx front door for BOTH:
#   api.baydspa.ca  →  127.0.0.1:8080  (kamal-proxy → Rails container)
#   baydspa.ca      →  127.0.0.1:3001  (Next.js, run by bayd-frontend.service)
#
# Get TLS certs FIRST (nginx can't start with an ssl block before the certs
# exist). With DNS already pointing here:
#   sudo certbot --nginx -d baydspa.ca -d www.baydspa.ca -d api.baydspa.ca \
#        --agree-tos -m admin@baydspa.ca --redirect
# certbot fills in the ssl_certificate lines + the :80 redirects and auto-renews.

# ── API ──────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.baydspa.ca;

    ssl_certificate     /etc/letsencrypt/live/api.baydspa.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.baydspa.ca/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 15m;   # room for job-application PDF uploads

    location / {
        proxy_pass http://127.0.0.1:8080;   # kamal-proxy (routes by Host to the app)
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;   # so Rails knows it's TLS
        proxy_read_timeout 30s;
    }
}

# ── Frontend ─────────────────────────────────────────────────────────────────
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name baydspa.ca;

    ssl_certificate     /etc/letsencrypt/live/baydspa.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/baydspa.ca/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:3001;   # Next.js (bayd-frontend.service)
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}

# www → apex
server {
    listen 443 ssl http2;
    server_name www.baydspa.ca;
    ssl_certificate     /etc/letsencrypt/live/baydspa.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/baydspa.ca/privkey.pem;
    return 301 https://baydspa.ca$request_uri;
}

# http → https (certbot adds/maintains these too)
server {
    listen 80;
    listen [::]:80;
    server_name baydspa.ca www.baydspa.ca api.baydspa.ca;
    return 301 https://$host$request_uri;
}
