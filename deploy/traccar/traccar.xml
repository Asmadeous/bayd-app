<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>
    <!-- Traccar server config for B.A.Y.D. Uses the built-in H2 database
         (fine for this scale). The important part is the event/position
         FORWARDING to the Rails webhook. -->

    <entry key='config.default'>./conf/default.xml</entry>

    <!-- Web UI / REST API bind (container-internal; nginx fronts it). -->
    <entry key='web.port'>8082</entry>

    <!-- ── Forward every position to the Rails webhook ──────────────────────
         Rails endpoint: POST https://api.baydspa.ca/api/v1/webhooks/traccar
         The controller checks the X-Traccar-Secret header against
         TRACCAR_WEBHOOK_SECRET — set the SAME value in both places.
         forward.url uses Traccar's template params; the JSON body wraps a
         single position under "positions": [ ... ], which the Rails
         WebhookProcessor expects (Array(payload[:positions])). -->
    <entry key='forward.enable'>true</entry>
    <entry key='forward.type'>json</entry>
    <entry key='forward.url'>https://api.baydspa.ca/api/v1/webhooks/traccar</entry>
    <entry key='forward.header'>X-Traccar-Secret: REPLACE_WITH_TRACCAR_WEBHOOK_SECRET</entry>

    <!-- Keep only recent history in Traccar itself; Rails stores the durable
         LocationPing history. Purge Traccar positions older than 7 days. -->
    <entry key='database.positionsHistoryDays'>7</entry>
</properties>
