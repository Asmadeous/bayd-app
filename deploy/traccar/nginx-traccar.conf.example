# /etc/nginx/sites-available/traccar.baydspa.ca  →  symlink into sites-enabled/
#
# Public front door for the Traccar web UI / REST API:
#   traccar.baydspa.ca  →  127.0.0.1:8082  (traccar container)
#
# Prereqs:
#   1. DNS A record: traccar.baydspa.ca → 64.6.175.177
#   2. Add the domain to your existing cert (single cert covers all names):
#        sudo certbot --nginx -d baydspa.ca -d www.baydspa.ca \
#             -d api.baydspa.ca -d traccar.baydspa.ca --expand
#      This puts/keeps the cert at /etc/letsencrypt/live/baydspa.ca/.
#
# NOTE: the phone apps talk to the DEVICE port (5055) directly by IP:port, NOT
# through nginx. nginx only fronts the human-facing web UI + REST API on 8082.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name traccar.baydspa.ca;

    ssl_certificate     /etc/letsencrypt/live/baydspa.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/baydspa.ca/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        # Traccar's UI uses WebSockets for live map updates.
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;
    }
}

# http → https (certbot maintains this once traccar.baydspa.ca is in the cert)
server {
    listen 80;
    listen [::]:80;
    server_name traccar.baydspa.ca;
    return 301 https://$host$request_uri;
}
