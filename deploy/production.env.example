# ─────────────────────────────────────────────────────────────────────────────
# Production secrets for Kamal.  Copy → fill → keep OUT of git:
#
#     cp deploy/production.env.example deploy/production.env
#     # edit deploy/production.env with real values
#     set -a && source deploy/production.env && set +a   # load into your shell
#     bin/kamal deploy                                     # .kamal/secrets reads them
#
# Non-secret config (hosts, URLs, gateway choice) lives in config/deploy.yml.
# This file holds only the sensitive values referenced by .kamal/secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Container registry (e.g. a GitHub personal access token with write:packages)
KAMAL_REGISTRY_PASSWORD=

# Rails — generate with:  bin/rails secret
SECRET_KEY_BASE=

# Database (matches DB_HOST in config/deploy.yml)
DB_USERNAME=bayd
DB_PASSWORD=

# SMTP (Postmark / SendGrid / SES). Also set SMTP_ADDRESS in deploy.yml env.clear.
SMTP_USERNAME=
SMTP_PASSWORD=

# Google
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=

# Error monitoring
SENTRY_DSN=

# Payments — Helcim (products/gift cards)
HELCIM_API_TOKEN=
HELCIM_WEBHOOK_VERIFIER_TOKEN=

# Payments — Square (checkout + card-on-file)
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# SimplyBook
SIMPLYBOOK_LOGIN=
SIMPLYBOOK_PASSWORD=
SIMPLYBOOK_WEBHOOK_SECRET=
