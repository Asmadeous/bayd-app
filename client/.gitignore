# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor: the bundled web build is regenerated by `cap sync` (from out/)
android/app/src/main/assets/public
ios/App/App/public
capacitor.config.json
android-employee/app/src/main/assets/public
ios-employee/App/App/public
android-admin/app/src/main/assets/public
ios-admin/App/App/public
