<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext HTTP ONLY to the local dev API. 10.0.2.2 is the Android
  emulator's alias for the host machine's localhost, so the app can reach a Rails
  dev server (http://10.0.2.2:3000). Production (api.baydspa.ca) stays HTTPS-only.
  This is for local testing; remove or keep scoped to dev hosts before release.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
