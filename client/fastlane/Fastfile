# Fastlane release automation for the two BAYD Capacitor apps (customer + staff),
# both platforms. One codebase, so lanes are parameterized by `app:` and read all
# secrets from the environment (set by GitHub Actions). Nothing sensitive lives
# here. See deploy/mobile/RELEASE.md for the full credential + deploy runbook.
#
# Usage (called by CI, but runnable locally with the env set):
#   bundle exec fastlane android internal app:customer
#   bundle exec fastlane android production app:staff
#   bundle exec fastlane ios beta app:customer
#   bundle exec fastlane ios release app:staff

# app key -> package/bundle id, native project dir, the CAP_APP value, and the
# npm build script suffix. Note: the staff CAP_APP + npm script are "employee",
# not "staff" - the store-facing name differs from the internal codename.
APPS = {
  "customer" => { id: "ca.baydspa.customer", android_dir: "android",          ios_dir: "ios",          cap: "customer", script: "build:mobile" },
  "staff"    => { id: "ca.baydspa.staff",    android_dir: "android-employee", ios_dir: "ios-employee", cap: "employee", script: "build:mobile:employee" }
}.freeze

def app_config(options)
  key = options[:app]
  UI.user_error!("Pass app:customer or app:staff") unless APPS.key?(key)
  APPS[key]
end

# Build the static web bundle for this app (bakes the production API URL) and
# sync it into the native project, exactly as scripts/build-mobile.mjs does.
def build_web_bundle(cfg)
  sh("cd .. && CAP_APP=#{cfg[:cap]} MOBILE_API_URL=https://api.baydspa.ca/api/v1 " \
     "npm run #{cfg[:script]} && CAP_APP=#{cfg[:cap]} npx cap sync")
end

platform :android do
  # Assemble a signed AAB and upload it to a Play track.
  # track: "internal" (testers) or "production".
  private_lane :android_release do |options|
    cfg = app_config(options)
    track = options[:track] || "internal"
    project_dir = "../#{cfg[:android_dir]}"

    build_web_bundle(cfg)

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: project_dir,
      properties: {
        "BAYD_VERSION_CODE" => ENV["BAYD_VERSION_CODE"],
        "BAYD_VERSION_NAME" => ENV["BAYD_VERSION_NAME"]
      }.compact
    )

    upload_to_play_store(
      package_name: cfg[:id],
      track: track,
      aab: "#{project_dir}/app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["SUPPLY_JSON_KEY_DATA"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: track == "production" ? "completed" : "draft"
    )
  end

  desc "Build + upload the app to Play internal testing (app:customer|staff)"
  lane :internal do |options|
    android_release(options.merge(track: "internal"))
  end

  desc "Build + upload the app to Play production (app:customer|staff)"
  lane :production do |options|
    android_release(options.merge(track: "production"))
  end
end

platform :ios do
  # Fetch signing assets (match), build a signed IPA, upload to ASC.
  private_lane :ios_release do |options|
    cfg = app_config(options)
    # Absolute, because fastlane does not use one working directory for every
    # action: `sh` runs from fastlane/, while build_app resolves relative paths
    # from client/. A relative "../" is therefore correct for only one of them
    # and sent build_app looking outside client/ for the Xcode project.
    project_dir = File.expand_path("#{cfg[:ios_dir]}/App", File.expand_path("..", FastlaneCore::FastlaneFolder.path))

    build_web_bundle(cfg)

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Signing certs + provisioning profiles from the private match repo.
    match(
      type: "appstore",
      app_identifier: cfg[:id],
      readonly: true,
      git_url: ENV["MATCH_GIT_URL"]
    )

    # match installs the profiles, but the Xcode project ships with automatic
    # signing and no team, so xcodebuild refuses to archive. Write manual signing
    # onto the App TARGET only: applying it globally (via xcargs) also hits the
    # SPM package targets, which cannot take a provisioning profile and fail the
    # build. profile_name comes from match itself, so the name stays correct even
    # when Apple appends a suffix to a regenerated profile.
    update_code_signing_settings(
      path: "#{project_dir}/App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"] || "HFZWQ3G4MV",
      targets: ["App"],
      bundle_identifier: cfg[:id],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][cfg[:id]]
    )

    # Square.xcconfig carries a sandbox id so local builds work out of the box.
    # A SQUARE_APPLICATION_ID from CI must win over it, and an xcconfig value is
    # only overridden on the xcodebuild command line, not by the environment.
    xcargs = "CURRENT_PROJECT_VERSION=#{ENV['BAYD_VERSION_CODE']} MARKETING_VERSION=#{ENV['BAYD_VERSION_NAME']}"
    square_id = ENV["SQUARE_APPLICATION_ID"].to_s
    xcargs += " SQUARE_APPLICATION_ID='#{square_id}'" unless square_id.empty?

    build_app(
      project: "#{project_dir}/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_team_id: ENV["APPLE_TEAM_ID"] || "HFZWQ3G4MV",
      export_options: {
        provisioningProfiles: {
          cfg[:id] => lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][cfg[:id]]
        }
      },
      output_directory: "#{project_dir}/build",
      xcargs: xcargs
    )

    if options[:track] == "production"
      upload_to_app_store(
        app_identifier: cfg[:id],
        skip_metadata: true,
        skip_screenshots: true,
        precheck_include_in_app_purchases: false,
        submit_for_review: false
      )
    else
      upload_to_testflight(
        app_identifier: cfg[:id],
        skip_waiting_for_build_processing: true
      )
    end
  end

  desc "Build + upload the app to TestFlight (app:customer|staff)"
  lane :beta do |options|
    ios_release(options.merge(track: "beta"))
  end

  desc "Build + upload the app to App Store review (app:customer|staff)"
  lane :release do |options|
    ios_release(options.merge(track: "production"))
  end

  desc "Seed or refresh the match repo's signing certs + profiles (force:true to regenerate)"
  lane :certs do |options|
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # readonly: false so match creates whatever is missing. The bare `match` CLI
    # cannot do this: it never sees the API key configured above, so it falls
    # back to an Apple ID prompt and dies in a non-interactive shell.
    # force_legacy_encryption: match's default AES-256-GCM encryption needs real
    # OpenSSL. macOS system Ruby links LibreSSL, which cannot set GCM additional
    # authenticated data, so seeding fails with "Error encrypting". The legacy
    # AES-256-CBC path works everywhere, CI included.
    # force regenerates the profiles rather than reusing what the repo holds.
    # Needed whenever an App ID's capabilities change: an existing profile is
    # never rewritten in place, so a newly granted entitlement (Tap to Pay) only
    # appears in a freshly issued one.
    match(
      type: "appstore",
      app_identifier: APPS.values.map { |c| c[:id] },
      readonly: false,
      force: options[:force].to_s == "true",
      force_legacy_encryption: true
    )
  end
end
