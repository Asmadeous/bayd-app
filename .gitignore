# Bundler
/.bundle
/vendor/bundle

# Rails
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep

# Database
/db/*.sqlite3
/db/*.sqlite3-journal

# Secrets and env
.env
.env.*
!.env.example
deploy/production.env
/config/master.key
/config/credentials/*.key

# Storage
/storage/*
!/storage/.keep
/public/assets

# Node / JS
/node_modules
/yarn-error.log

# Editor
.DS_Store
.idea/
*.swp
*.swo

# Coverage
/coverage

# Raw Shopify product export dumps (source data; seeds are derived from these)
products_export_*.csv
products_export_*.md
client-ios.zip
**/*.p8
**/*.keystore
# Firebase per-app config (contains client API keys). Also catches raw downloads
# left at the repo root, including browser-suffixed duplicates like
# "GoogleService-Info (1).plist".
**/GoogleService-Info*.plist
docs/*.json
google-services*.json

# Other Apple signing material (*.p8 / *.keystore are ignored above)
**/*.p12
**/*.mobileprovision
**/*.cer
