# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=

# App
SECRET_KEY_BASE=changeme_run_rails_secret

# CORS — comma-separated list
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Traccar
TRACCAR_URL=http://localhost:8082
TRACCAR_USER=admin
TRACCAR_PASSWORD=admin
TRACCAR_WEBHOOK_SECRET=changeme

# Google Maps (for geocoding)
GOOGLE_MAPS_API_KEY=

# Google OAuth (SSO) — client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# Push notifications — FCM HTTP v1 (leave blank to disable; push is inert)
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# Phone-OTP login — Infobip SMS (leave blank to disable; OTP send is inert).
# INFOBIP_BASE_URL is your account's personalized host, e.g. https://xxxxx.api.infobip.com
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=BAYD

# Passkeys / WebAuthn — optional. Origins come from ALLOWED_ORIGINS; set the
# relying-party id to your registrable domain in production (e.g. baydspa.ca).
WEBAUTHN_RP_ID=
