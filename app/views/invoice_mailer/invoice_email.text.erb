<% d = @invoice.details || {} %>
<% appt = d["appointment"] %>
<%= @invoice.status_paid? ? "Paid receipt" : "Invoice" %> <%= @invoice.invoice_number %> (<%= @invoice.status_paid? ? "PAID" : "UNPAID" %>)

Hi <%= @user.first_name.presence || "there" %>, thank you for choosing Beauty @ Your Door.
Your invoice for <%= @invoice.franchise.money(@invoice.total) %> <%= @invoice.currency %> is attached as a PDF.
<% if appt %>

Service: <%= appt["service"] %>
Date: <%= appt["date"] %>
Time: <%= [appt["start_time"], appt["end_time"]].compact.join(" - ") %>
<% if appt["technician"] %>Technician: <%= appt["technician"] %>
<% end %>Booking ref.: <%= appt["reference"] %>
<% end %>

<% @invoice.line_items.each do |li| %><%= li["description"] %>: <%= @invoice.franchise.money(li["amount"]) %>
<% end %><%= @invoice.details&.dig("business", "tax_name") || "Tax" %> included: <%= @invoice.franchise.money(@invoice.tax) %>
Total: <%= @invoice.franchise.money(@invoice.total) %> <%= @invoice.currency %>
<% if d.key?("balance_due") %>Balance due: <%= @invoice.franchise.money(d["balance_due"]) %>
<% end %>

You can also view and download all your invoices from your dashboard.
<%= render "shared/get_the_app" %>
