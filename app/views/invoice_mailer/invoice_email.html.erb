<% d = @invoice.details || {} %>
<% appt = d["appointment"] %>
<% addr = d["service_address"] %>
<h1 style="font-size:20px; margin:16px 0 8px;"><%= @invoice.status_paid? ? "Paid receipt" : "Invoice" %> <%= @invoice.invoice_number %></h1>
<p style="display:inline-block; margin:0 0 8px; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:bold; letter-spacing:0.08em; <%= @invoice.status_paid? ? "background:#e6f2e7; color:#3f7e47;" : "background:#f8e9ed; color:#9e4a60;" %>"><%= @invoice.status_paid? ? "PAID" : "UNPAID" %></p>

<p style="font-size:15px; line-height:1.6; color:#4f535a;">
  Hi <%= @user.first_name.presence || "there" %>, thank you for choosing Beauty @ Your Door.
  Your invoice for <strong><%= @invoice.franchise.money(@invoice.total) %> <%= @invoice.currency %></strong>
  is attached as a PDF.
</p>

<% if appt %>
  <table cellpadding="0" cellspacing="0" style="width:100%; font-size:14px; color:#101217; margin:12px 0;">
    <% [
      ["Service", appt["service"]],
      ["Date", appt["date"]],
      ["Time", [appt["start_time"], appt["end_time"]].compact.join(" - ").presence],
      ["Technician", appt["technician"]],
      ["Address", addr && [addr["line1"], addr["line2"], addr["city"], addr["postal_code"]].compact.join(", ")],
      ["Booking ref.", appt["reference"]]
    ].each do |label, value| %>
      <% next if value.blank? %>
      <tr>
        <td style="padding:3px 12px 3px 0; color:#5f6268; width:110px;"><%= label %></td>
        <td style="padding:3px 0;"><%= value %></td>
      </tr>
    <% end %>
  </table>
<% end %>

<table cellpadding="0" cellspacing="0" style="width:100%; font-size:14px; color:#101217; margin:12px 0; border-top:1px solid #e6e2dc;">
  <% @invoice.line_items.each do |li| %>
    <tr>
      <td style="padding:6px 0;"><%= li["description"] %><%= " x#{li['quantity']}" if li["quantity"].to_i > 1 %></td>
      <td style="padding:6px 0; text-align:right;"><%= @invoice.franchise.money(li["amount"]) %></td>
    </tr>
  <% end %>
  <tr><td style="padding:6px 0; color:#5f6268; border-top:1px solid #e6e2dc;"><%= @invoice.details&.dig("business", "tax_name") || "Tax" %> included</td><td style="padding:6px 0; text-align:right; color:#5f6268; border-top:1px solid #e6e2dc;"><%= @invoice.franchise.money(@invoice.tax) %></td></tr>
  <tr><td style="padding:6px 0; font-weight:bold;">Total</td><td style="padding:6px 0; text-align:right; font-weight:bold;"><%= @invoice.franchise.money(@invoice.total) %> <%= @invoice.currency %></td></tr>
  <% if d.key?("balance_due") %>
    <tr><td style="padding:6px 0; color:#5f6268;">Paid<%= " (#{@invoice.payment_method})" if @invoice.payment_method.present? %></td><td style="padding:6px 0; text-align:right; color:#5f6268;"><%= @invoice.franchise.money(d["amount_paid"]) %></td></tr>
    <tr><td style="padding:6px 0; font-weight:bold; color:<%= d["balance_due"].to_f.positive? ? "#c96c83" : "#3f7e47" %>;">Balance due</td><td style="padding:6px 0; text-align:right; font-weight:bold;"><%= @invoice.franchise.money(d["balance_due"]) %></td></tr>
  <% end %>
</table>

<p style="font-size:14px; color:#4f535a;">
  You can also view and download all your invoices anytime from your dashboard.
</p>

<% if @invoice.pdf.attached? %>
  <p style="font-size:13px; color:#5f6268;">📎 <%= @invoice.invoice_number %>.pdf attached</p>
<% end %>

<%= render "shared/get_the_app" %>
