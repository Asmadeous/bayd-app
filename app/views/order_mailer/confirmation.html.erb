<h1 style="font-size:22px; margin:16px 0 8px;">Thanks for your order, <%= @user.first_name.presence || "there" %>!</h1>
<p style="font-size:15px; line-height:1.6; color:#4f535a;">
  Your order is confirmed. Invoice <strong><%= @invoice.invoice_number %></strong> is attached as a PDF.
</p>

<table style="width:100%; border-collapse:collapse; margin-top:16px; font-size:14px;">
  <tr style="text-align:left; color:#5f6268; border-bottom:1px solid #eee;">
    <th style="padding:6px 0;">Item</th><th style="padding:6px 0; text-align:center;">Qty</th><th style="padding:6px 0; text-align:right;">Amount</th>
  </tr>
  <% @order.order_items.each do |item| %>
    <tr style="border-bottom:1px solid #f4f1eb;">
      <td style="padding:6px 0;"><%= item.name %></td>
      <td style="padding:6px 0; text-align:center;"><%= item.quantity %></td>
      <td style="padding:6px 0; text-align:right;">$<%= format("%.2f", item.price.to_f * item.quantity) %></td>
    </tr>
  <% end %>
  <tr>
    <td colspan="2" style="padding:10px 0; font-weight:700;">Total</td>
    <td style="padding:10px 0; text-align:right; font-weight:700; color:#c96c83;">$<%= format("%.2f", @order.total) %></td>
  </tr>
</table>

<% if @order.shipping_address %>
  <p style="font-size:13px; color:#5f6268; margin-top:16px;">
    <strong>Shipping to:</strong><br>
    <%= [@order.shipping_address.line1, @order.shipping_address.line2].compact.join(", ") %><br>
    <%= [@order.shipping_address.city, @order.shipping_address.province, @order.shipping_address.postal_code].compact.join(", ") %>
  </p>
<% end %>

<p style="font-size:14px; color:#4f535a; margin-top:16px;">We'll email you tracking details as soon as it ships.</p>
