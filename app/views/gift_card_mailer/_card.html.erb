<%# Designed gift card with the redeemable code (email-safe inline styles). %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:18px 0;">
  <tr>
    <td>
      <div style="max-width:420px; border-radius:18px; padding:24px; color:#ffffff;
                  background:linear-gradient(135deg,#c96c83 0%,#a36f4d 100%);
                  box-shadow:0 10px 24px rgba(16,18,23,0.18);">
        <table role="presentation" width="100%">
          <tr>
            <td style="font-size:12px; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; opacity:0.85;">
              Beauty @ Your Door
            </td>
            <td style="text-align:right; font-size:11px; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; opacity:0.85;">
              Gift Card
            </td>
          </tr>
        </table>

        <div style="font-size:40px; font-weight:800; margin:18px 0 4px;">
          $<%= format("%.2f", @gift_card.current_balance) %>
        </div>
        <div style="font-size:12px; opacity:0.85;">value</div>

        <div style="margin-top:20px; background:rgba(255,255,255,0.16); border-radius:10px; padding:12px 14px;">
          <div style="font-size:10px; letter-spacing:0.16em; text-transform:uppercase; opacity:0.85;">Redeem code</div>
          <div style="font-family:'Courier New',monospace; font-size:22px; font-weight:700; letter-spacing:0.12em; margin-top:4px;">
            <%= @gift_card.code %>
          </div>
        </div>

        <table role="presentation" width="100%" style="margin-top:16px; font-size:11px; opacity:0.9;">
          <tr>
            <td><%= @gift_card.expires_at ? "Expires #{@gift_card.expires_at.strftime('%b %-d, %Y')}" : "No expiry" %></td>
            <td style="text-align:right;">baydspa.ca</td>
          </tr>
        </table>
      </div>
    </td>
  </tr>
</table>
