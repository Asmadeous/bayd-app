<h1 style="font-size:22px; margin:16px 0 8px;"><%= @notification.title %></h1>

<% if @notification.body.present? %>
  <p style="font-size:15px; line-height:1.6; color:#4f535a;"><%= @notification.body %></p>
<% end %>

<% if @action_url.present? %>
  <a href="<%= @action_url %>" class="btn"><%= @notification.metadata["cta"] || "View details" %></a>
<% end %>
