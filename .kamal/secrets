# Kamal reads this at deploy time. Each secret is pulled from the shell
# environment — populate it first:  set -a && source deploy/production.env && set +a
# NEVER put raw credentials in this file (it's committed to git).

RAILS_MASTER_KEY=$(cat config/master.key)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

SECRET_KEY_BASE=$SECRET_KEY_BASE
DB_USERNAME=$DB_USERNAME
DB_PASSWORD=$DB_PASSWORD
# The Postgres accessory container reads these; same values as DB_USERNAME/
# DB_PASSWORD so the app and the DB always share one credential.
POSTGRES_USER=$DB_USERNAME
POSTGRES_PASSWORD=$DB_PASSWORD

SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD

GOOGLE_MAPS_API_KEY=$GOOGLE_MAPS_API_KEY
GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
SENTRY_DSN=$SENTRY_DSN

HELCIM_API_TOKEN=$HELCIM_API_TOKEN
HELCIM_WEBHOOK_VERIFIER_TOKEN=$HELCIM_WEBHOOK_VERIFIER_TOKEN
SQUARE_ACCESS_TOKEN=$SQUARE_ACCESS_TOKEN
SQUARE_WEBHOOK_SIGNATURE_KEY=$SQUARE_WEBHOOK_SIGNATURE_KEY

# Push (FCM) + phone-OTP (Infobip) — blank keeps each feature inert
FCM_PROJECT_ID=$FCM_PROJECT_ID
FCM_CREDENTIALS_JSON=$FCM_CREDENTIALS_JSON
INFOBIP_BASE_URL=$INFOBIP_BASE_URL
INFOBIP_API_KEY=$INFOBIP_API_KEY
INFOBIP_SENDER=$INFOBIP_SENDER

SQUARE_LOCATION_ID=$SQUARE_LOCATION_ID
# Square Tap to Pay POS (staff app). App id isn't secret (ships in the app) but
# is sourced here for one place; environment is production/sandbox. Blank keeps
# Tap to Pay inert (payment-link fallback).
SQUARE_APPLICATION_ID=$SQUARE_APPLICATION_ID
SQUARE_ENVIRONMENT=$SQUARE_ENVIRONMENT
SMTP_ADDRESS=$SMTP_ADDRESS

